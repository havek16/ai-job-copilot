# ─────────────────────────────────────────────
# AI Job-Application Copilot — Environment Keys
# Copy this file to .env and fill in real values
# Never commit the real .env file!
# ─────────────────────────────────────────────

# LLM: Groq (primary) — https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# LLM: Google Gemini (fallback) — https://aistudio.google.com
GEMINI_API_KEY=AIza_your_gemini_key_here

# Web Search: Tavily — https://tavily.com (free tier: 1000 req/month)
TAVILY_API_KEY=tvly_your_tavily_key_here

# ─── Optional overrides (defaults in config.py) ───────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# TEMPERATURE=0.3
# MAX_RETRIES=2
# REQUEST_TIMEOUT_S=20
# LOG_LEVEL=INFO
